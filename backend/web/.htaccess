<IfModule mod_rewrite.c>
  RewriteEngine On
  # If this project is served from a subpath (e.g. /fresh-degree-guru/backend/web),
  # set RewriteBase accordingly so rewrites map correctly. Update if needed.
  RewriteBase /fresh-degree-guru/backend/web/

  # Disable MultiViews to avoid content negotiation mapping paths to PHP
  Options -MultiViews

  # Don't rewrite requests for existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exclude backend/admin/api/uploads paths from SPA rewrite
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/admin/ [OR]
  RewriteCond %{REQUEST_URI} ^/backend/ [OR]
  RewriteCond %{REQUEST_URI} ^/uploads/
  RewriteRule ^ - [L]

  # Otherwise serve the SPA index.html
  RewriteRule ^.*$ /index.html [L,QSA]
</IfModule>

# FallbackResource is a robust fallback that serves index.html for non-file routes
# (available on Apache >=2.2.16). It protects against other server-level rewrites.
FallbackResource /index.html

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
